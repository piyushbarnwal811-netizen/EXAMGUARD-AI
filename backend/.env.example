# App Configuration
APP_NAME=ExamGuard Pro
SECRET_KEY=change-this-to-a-very-strong-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./examguard_prod.db
# Production PostgreSQL example (Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/examguard?sslmode=require

DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# Security & CORS
CORS_ORIGINS=["*"]
ALLOWED_IP_RANGES=127.0.0.1/32,::1/128

